@page "/register"
@layout Layout.AuthLayout
@implements IDisposable
@inject NavigationManager NavManager
@inject AuthStateContainer AuthState

<div class="auth-page">
    

    <div class="auth-card">
        <div class="auth-header">
            <div class="brand-box">🪐</div>
            <h1>Tạo tài khoản mới</h1>
            <p class="subtitle">Bắt đầu hành trình của bạn với chúng tôi</p>
        </div>
        <div class="tabs">
            <button class="tab" type="button" @onclick="GoLogin">Đăng nhập</button>
            <button class="tab active" type="button">Đăng ký</button>
        </div>

        <EditForm Model="AuthState.RegisterModel" OnValidSubmit="HandleRegisterAsync">
            <DataAnnotationsValidator />

            <label>Họ và tên</label>
            <div class="input-wrap">
                <span class="left-icon">👤</span>
                <InputText class="input" @bind-Value="AuthState.RegisterModel.FullName" placeholder="Nguyễn Văn A" />
            </div>
            <ValidationMessage For="() => AuthState.RegisterModel.FullName" class="validation" />

            <label>Email</label>
            <div class="input-wrap">
                <span class="left-icon">✉</span>
                <InputText class="input" @bind-Value="AuthState.RegisterModel.Email" placeholder="nam@example.com" />
            </div>
            <ValidationMessage For="() => AuthState.RegisterModel.Email" class="validation" />

            <label>Mật khẩu</label>
            <div class="input-wrap password-wrap">
                <span class="left-icon">🔒</span>
                <InputText class="input" type="@(AuthState.ShowRegisterPassword ? "text" : "password")" @bind-Value="AuthState.RegisterModel.Password" placeholder="Tạo mật khẩu (ít nhất 8 ký tự)" />
                <button class="eye" type="button" @onclick="AuthState.ToggleRegisterPassword">👁</button>
            </div>
            <p class="password-hint">ⓘ Mật khẩu phải có ít nhất 8 ký tự.</p>
            <ValidationMessage For="() => AuthState.RegisterModel.Password" class="validation" />

            <button class="primary-btn" type="submit" disabled="@AuthState.IsBusy">@(AuthState.IsBusy ? "Đang xử lý..." : "Tạo Tài Khoản")</button>
        </EditForm>

        <p class="policy">
            Bằng việc đăng ký, bạn đồng ý với <span>Điều khoản</span> và <span>Chính sách bảo mật</span> của chúng tôi.
        </p>

        @if (!string.IsNullOrWhiteSpace(AuthState.StatusMessage))
        {
            <p class="status @(AuthState.IsError ? "error" : "success")">@AuthState.StatusMessage</p>
        }
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthState.ClearStatus();
        AuthState.OnChange += StateHasChanged;
    }

    private async Task HandleRegisterAsync()
    {
        await AuthState.RegisterAsync();

        if (!AuthState.IsError)
        {
            NavManager.NavigateTo("/login");
        }
    }

    private void GoLogin() => NavManager.NavigateTo("/login");

    public void Dispose()
    {
        AuthState.OnChange -= StateHasChanged;
    }
}
